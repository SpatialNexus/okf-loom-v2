# Per-bundle transaction lock file (okf_loom.io_utils.BUNDLE_LOCK_FILENAME)
# and local handoff snapshots: never commit them.
.okf-loom-bundle.lock
/okf-loom-v2-handoff-*/
/okf-loom-v2-handoff-*.zip

# Local work tracker: kept on disk, not published.
/future-work.md

# Studio session state (ephemeral live feed + undo + auth token;
# per-bundle). Duplicated from the parent repo's ignore so a standalone
# clone of this directory (the documented skill distribution model) keeps
# ignoring samples/*/.okf-loom/session/.
**/.okf-loom/session/

